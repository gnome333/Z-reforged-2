*.vvd
*.vtx
*.phy
*.ani
*.vmt
*.vtf
*.png
*.jpg
*.jpeg
*.tga
*.wav
*.mp3
*.ogg
*.bsp
*.gma

# ─── 2. КЭШ, ЛОГИ И МУСОР ───
cache/
downloads/
logs/
*.log
*.tmp
*.dmp
*.mdmp

# ─── 3. СГЕНЕРИРОВАННЫЙ КОД И АРТЕФАКТЫ СБОРКИ ───
dist/
build/
out/
*.min.js
*.map

# ─── 4. СИСТЕМНЫЕ И КОНФИДЕНЦИАЛЬНЫЕ ФАЙЛЫ ───
